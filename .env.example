# ---- Server ----
PORT=3000
HOST=0.0.0.0

# ---- PostgreSQL ----
# Local example: postgres://postgres:postgres@localhost:5432/fzauth
# Neon/Supabase example: postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fzauth

# ---- Master key ----
# Protects creation of new apps (/admin/apps). Keep this SECRET and long.
MASTER_KEY=change-me-to-a-long-random-string

# ---- Discord Bot (Phase 2) ----
BOT_TOKEN=your-discord-bot-token
CLIENT_ID=your-discord-application-client-id
GUILD_ID=your-discord-server-id
ADMIN_ROLE_ID=your-admin-role-id
LOG_CHANNEL_ID=your-log-channel-id

# Which FZ Auth app this bot manages
API_URL=http://localhost:3000
APP_ID=the-app-id-from-admin-apps
ADMIN_KEY=that-apps-admin-key

# ===== Web Panel (Next.js — copy these into panel/.env.local) =====
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=from-google-cloud-console
GOOGLE_CLIENT_SECRET=from-google-cloud-console
GITHUB_CLIENT_ID=from-github-oauth-app
GITHUB_CLIENT_SECRET=from-github-oauth-app
# DATABASE_URL same as above (panel shares the API's database)
FZAUTH_API_URL=http://localhost:3000
# MASTER_KEY same as above (panel server uses it to create apps)
