# Copy to .env.local and fill in real values.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=from-google-cloud-console
GOOGLE_CLIENT_SECRET=from-google-cloud-console
# Same database the Fastify API uses:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fzauth
FZAUTH_API_URL=http://localhost:3000
# Same MASTER_KEY as the API's .env (used server-side to create apps):
MASTER_KEY=change-me-to-a-long-random-string
